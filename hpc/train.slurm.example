#!/bin/bash
# Change the partition, account, memory, and time values for your college cluster.
#SBATCH --job-name=medfusionnet
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=2-00:00:00
#SBATCH --output=logs/medfusionnet-%j.out
#SBATCH --error=logs/medfusionnet-%j.err

set -euo pipefail
cd "${SLURM_SUBMIT_DIR}"
source .venv/bin/activate

nvidia-smi
python -c "import torch; print('PyTorch:', torch.__version__); print('CUDA:', torch.cuda.is_available()); print('GPU:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'NONE')"

resume_args=()
if [[ -f checkpoints/medfusionnet_last.pt ]]; then
  resume_args=(--resume checkpoints/medfusionnet_last.pt)
fi

python train.py \
  --epochs 100 \
  --batch-size 16 \
  --num-workers "${SLURM_CPUS_PER_TASK:-8}" \
  "${resume_args[@]}"

